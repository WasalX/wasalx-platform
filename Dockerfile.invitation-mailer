# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee AS dependencies
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV XDG_CACHE_HOME=/pnpm/cache
RUN corepack enable && corepack prepare pnpm@11.16.0 --activate
WORKDIR /workspace
COPY infra/docker/pnpm.npmrc ./.npmrc
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
COPY services/control-api/package.json ./services/control-api/package.json
COPY services/connector-worker/package.json ./services/connector-worker/package.json
COPY services/tenant-provisioner/package.json ./services/tenant-provisioner/package.json
COPY services/invitation-mailer/package.json ./services/invitation-mailer/package.json
COPY services/identity-policy-activator/package.json ./services/identity-policy-activator/package.json
COPY packages/observability/package.json ./packages/observability/package.json
COPY packages/core/package.json ./packages/core/package.json
RUN --mount=type=cache,id=wasalx-pnpm-v11,target=/pnpm/store,sharing=locked \
    --mount=type=cache,id=pnpm-metadata,target=/pnpm/cache,sharing=locked \
    pnpm install --frozen-lockfile --prefer-offline

FROM dependencies AS build
COPY services/invitation-mailer ./services/invitation-mailer
COPY packages/observability ./packages/observability
COPY tsconfig.json ./tsconfig.json
RUN pnpm --filter @wasalx/observability build
RUN pnpm --filter @wasalx/invitation-mailer build
RUN --mount=type=cache,id=wasalx-pnpm-v11,target=/pnpm/store,sharing=locked \
    --mount=type=cache,id=pnpm-metadata,target=/pnpm/cache,sharing=locked \
    pnpm --prefer-offline --filter @wasalx/invitation-mailer deploy --prod --legacy /invitation-mailer
RUN cp -R services/invitation-mailer/dist /invitation-mailer/dist
RUN observability_package="$(find /invitation-mailer/node_modules/.pnpm -path '*/node_modules/@wasalx/observability' -type d -print -quit)" \
    && test -n "$observability_package" \
    && test -f "$observability_package/dist/node.js" \
    && test -L /invitation-mailer/node_modules/@wasalx/observability \
    && unlink /invitation-mailer/node_modules/@wasalx/observability \
    && observability_relative="../${observability_package#/invitation-mailer/node_modules/}" \
    && ln -s "$observability_relative" /invitation-mailer/node_modules/@wasalx/observability \
    && cd /invitation-mailer \
    && node -e "import('@wasalx/observability/node')"

FROM cgr.dev/chainguard/wolfi-base:latest@sha256:be019c1c74fe69204a42c4e10bc4d886a49bf5403ffa74374ef7baa408fc9a26 AS runtime
RUN apk add --no-cache 'libcrypto3=3.6.5-r1' 'libssl3=3.6.5-r1' 'libstdc++=16.2.0-r1' 'zlib=1.3.1-r51'
COPY --from=node:22-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d /usr/local/bin/node /usr/bin/node
RUN node -e "const assert = require('node:assert/strict'); assert.equal(process.version, 'v22.23.4'); assert.equal(process.versions.undici, '6.29.1')"
ENTRYPOINT []
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV NODE_ENV=production
ENV PORT=8085
WORKDIR /app
COPY --from=build --chown=65532:65532 /invitation-mailer/ ./
ARG WASALX_CANDIDATE_SHA=unfrozen
ARG WASALX_CANDIDATE_TREE=unfrozen
LABEL org.opencontainers.image.revision="${WASALX_CANDIDATE_SHA}" \
      io.wasalx.source.tree="${WASALX_CANDIDATE_TREE}"
USER 65532:65532
EXPOSE 8085
HEALTHCHECK --interval=20s --timeout=45s --start-period=60s --retries=3 CMD ["node","-e","fetch('http://127.0.0.1:8085/readyz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
ENTRYPOINT ["node","dist/bootstrap.js"]
