# syntax=docker/dockerfile:1.7
FROM docker.io/library/golang:1.27.4-alpine@sha256:70bd7ddea8b6cbe5d6943cde279d6b67feb10cc924fb9100d1d8757c1575b280 AS build
ARG TARGETOS=linux
ARG TARGETARCH=amd64
ENV GOPROXY=https://proxy.golang.org,direct
ENV GODEBUG=http2client=0
ADD https://github.com/cloudflare/cloudflared.git#f11dea9cb7079e90a982c1a2d5548ab40847fdcf /src
WORKDIR /src
RUN go get google.golang.org/grpc@v1.83.2 && \
    CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" go build -mod=mod -trimpath \
      -ldflags='-s -w -X main.Version=2026.9.1 -X github.com/cloudflare/cloudflared/metrics.Runtime=virtual' \
      -o /cloudflared ./cmd/cloudflared

FROM gcr.io/distroless/static-debian13:nonroot@sha256:8ce6dd87e9823c5b48dcfb2c8604714ccb351ce59607327bcc4957448da279b5
ARG WASALX_CANDIDATE_SHA=unfrozen
ARG WASALX_CANDIDATE_TREE=unfrozen
LABEL org.opencontainers.image.revision="${WASALX_CANDIDATE_SHA}" \
      io.wasalx.source.tree="${WASALX_CANDIDATE_TREE}"
COPY --from=build --chown=65532:65532 /cloudflared /usr/local/bin/cloudflared
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/cloudflared", "--no-autoupdate"]
CMD ["version"]
