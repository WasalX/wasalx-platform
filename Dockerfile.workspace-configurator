# syntax=docker/dockerfile:1.7
FROM node:26-bookworm-slim@sha256:5df79989ed685e09f0a98019db4cebfb22fb9df1a53c0161664a011f7ff6b0f1 AS dependencies
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV XDG_CACHE_HOME=/pnpm/cache
RUN corepack enable && corepack prepare pnpm@11.16.0 --activate
WORKDIR /workspace
COPY infra/docker/pnpm.npmrc ./.npmrc
WORKDIR /workspace/services/workspace-configurator
COPY services/workspace-configurator/package.json services/workspace-configurator/pnpm-lock.yaml ./
RUN --mount=type=cache,id=wasalx-pnpm-v11,target=/pnpm/store,sharing=locked \
    --mount=type=cache,id=pnpm-metadata,target=/pnpm/cache,sharing=locked \
    test "$(pnpm --version)" = "11.16.0" \
    && pnpm install --frozen-lockfile --ignore-workspace --prefer-offline

FROM dependencies AS build
COPY tsconfig.json /workspace/tsconfig.json
COPY services/workspace-configurator/tsconfig.json ./tsconfig.json
COPY services/workspace-configurator/src ./src
RUN pnpm build

FROM node:26-bookworm-slim@sha256:5df79989ed685e09f0a98019db4cebfb22fb9df1a53c0161664a011f7ff6b0f1 AS package-artifact
WORKDIR /workspace
COPY scripts/build-zammad-package.mjs ./scripts/build-zammad-package.mjs
COPY zammad-package ./zammad-package
RUN node scripts/build-zammad-package.mjs \
    && printf '%s  %s\n' \
      '00069cb9565f2a9002d5df73cc29532f3adde2fce28f4f09400370f9c9d11153' \
      'build/zammad/wasalx-0.5.83.zpm' | sha256sum --check --strict


# Reuse the hardened runtime and unaffected zlib pin used by the other services.
FROM cgr.dev/chainguard/wolfi-base:latest@sha256:3754b6da0e1ccdab0fe46abfdd7bbbba994b593c28149f6659fa6597f2261aeb AS runtime
RUN apk add --no-cache 'libcrypto3=3.6.5-r1' 'libssl3=3.6.5-r1' \
      'libstdc++=16.2.0-r1' \
      'postgresql-18-client=18.6-r2' \
      'age=1.3.2-r1' \
      'zlib=1.3.1-r51'
COPY --from=node:22-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d /usr/local/bin/node /usr/bin/node
RUN node -e "const assert = require('node:assert/strict'); assert.equal(process.version, 'v22.23.4'); assert.equal(process.versions.undici, '6.29.1')"
LABEL org.opencontainers.image.title="WasalX workspace configurator" \
      org.opencontainers.image.version="0.1.0" \
      io.wasalx.zammad-package.version="0.5.83" \
      io.wasalx.zammad-package.sha256="00069cb9565f2a9002d5df73cc29532f3adde2fce28f4f09400370f9c9d11153"

ENV NODE_ENV=production
ENV HOME=/tmp
ENV PATH=/usr/local/bin:/usr/bin:/bin
WORKDIR /app
COPY --from=build --chown=1000:1000 /workspace/services/workspace-configurator/package.json ./package.json
COPY --from=build --chown=1000:1000 /workspace/services/workspace-configurator/dist ./dist
COPY --from=package-artifact --chown=1000:1000 /workspace/build/zammad/wasalx-0.5.83.zpm /app/artifacts/wasalx-0.5.83.zpm

ARG WASALX_CANDIDATE_SHA=unfrozen
ARG WASALX_CANDIDATE_TREE=unfrozen
LABEL org.opencontainers.image.revision="${WASALX_CANDIDATE_SHA}" \
      io.wasalx.source.tree="${WASALX_CANDIDATE_TREE}"
USER 1000:1000
ENTRYPOINT ["node","dist/bootstrap.js"]
