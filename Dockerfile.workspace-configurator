# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim@sha256:be979e5523c76fa4d5ca4ebd3099078f220aa47ec39c48ad5b5df9314debd6eb AS node-base

FROM node-base AS dependencies
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV XDG_CACHE_HOME=/pnpm/cache
RUN corepack enable && corepack prepare pnpm@11.16.0 --activate
WORKDIR /workspace
COPY infra/docker/pnpm.npmrc ./.npmrc
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
COPY services/workspace-configurator/package.json ./services/workspace-configurator/package.json
RUN --mount=type=cache,id=wasalx-pnpm-v11,target=/pnpm/store,sharing=locked \
    --mount=type=cache,id=pnpm-metadata,target=/pnpm/cache,sharing=locked \
    test "$(pnpm --version)" = "11.16.0" \
    && pnpm install --frozen-lockfile --prefer-offline --filter @wasalx/workspace-configurator...

FROM dependencies AS build
WORKDIR /workspace/services/workspace-configurator
COPY tsconfig.json /workspace/tsconfig.json
COPY services/workspace-configurator/tsconfig.json ./tsconfig.json
COPY services/workspace-configurator/src ./src
RUN pnpm build

FROM node-base AS package-artifact
WORKDIR /workspace
COPY scripts/build-zammad-package.mjs ./scripts/build-zammad-package.mjs
COPY zammad-package ./zammad-package
RUN node scripts/build-zammad-package.mjs \
    && printf '%s  %s\n' \
      'd711e150f015376fbe77c1a64c67ff006e19069213c5c53e0d8c7a084d79b9e2' \
      'build/zammad/wasalx-0.5.91.zpm' | sha256sum --check --strict


# Reuse the hardened runtime and unaffected zlib pin used by the other services.
FROM cgr.dev/chainguard/wolfi-base:latest@sha256:5172a213d2bba8b1c9ca11957db65562b52b0f9844583a0347318ea5fd8e3aa5 AS runtime
RUN apk add --no-cache 'libcrypto3=3.6.5-r1' 'libssl3=3.6.5-r1' \
      'libstdc++=16.2.0-r1' \
      'postgresql-18-client=18.6-r2' \
      'age=1.3.2-r1' \
      'zlib=1.3.1-r51'
COPY --from=node-base /usr/local/bin/node /usr/bin/node
RUN node -e "const assert = require('node:assert/strict'); assert.equal(process.version, 'v22.23.5'); assert.equal(process.versions.undici, '6.29.1')"
LABEL org.opencontainers.image.title="WasalX workspace configurator" \
      org.opencontainers.image.version="0.1.0" \
      io.wasalx.zammad-package.version="0.5.91" \
      io.wasalx.zammad-package.sha256="d711e150f015376fbe77c1a64c67ff006e19069213c5c53e0d8c7a084d79b9e2"

ENV NODE_ENV=production
ENV HOME=/tmp
ENV PATH=/usr/local/bin:/usr/bin:/bin
WORKDIR /app
COPY --from=build --chown=1000:1000 /workspace/services/workspace-configurator/package.json ./package.json
COPY --from=build --chown=1000:1000 /workspace/services/workspace-configurator/dist ./dist
COPY --from=package-artifact --chown=1000:1000 /workspace/build/zammad/wasalx-0.5.91.zpm /app/artifacts/wasalx-0.5.91.zpm

ARG WASALX_CANDIDATE_SHA=unfrozen
ARG WASALX_CANDIDATE_TREE=unfrozen
LABEL org.opencontainers.image.revision="${WASALX_CANDIDATE_SHA}" \
      io.wasalx.source.tree="${WASALX_CANDIDATE_TREE}"
USER 1000:1000
ENTRYPOINT ["node","dist/bootstrap.js"]
