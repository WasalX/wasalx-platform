# syntax=docker/dockerfile:1.7
ARG WOLFI_BASE=cgr.dev/chainguard/wolfi-base:latest@sha256:be019c1c74fe69204a42c4e10bc4d886a49bf5403ffa74374ef7baa408fc9a26
FROM quay.io/keycloak/keycloak@sha256:ff4257d0d64efbe99ed1ddfaf07765cc3c36dc7518bf8324d41961327f441c54 AS keycloak
USER 0:0
ADD --checksum=sha256:d0e4c6ee4779f59f6ab2fb5d388e4f57147c82270164b37945764bb9bda96a44 \
  https://repo1.maven.org/maven2/io/netty/netty-handler/4.1.137.Final/netty-handler-4.1.137.Final.jar \
  /opt/keycloak/lib/lib/main/io.netty.netty-handler-4.1.136.Final.jar
# Preserve launcher paths while replacing vulnerable server and CLI libraries.
ADD --checksum=sha256:20af26bf6060bb8005cc2389916812c1e0e998dc48d2ced7131b89461b54cff7 \
  https://repo.maven.apache.org/maven2/org/bouncycastle/bcprov-jdk18on/1.85/bcprov-jdk18on-1.85.jar \
  /opt/keycloak/lib/lib/main/org.bouncycastle.bcprov-jdk18on-1.84.jar
ADD --checksum=sha256:c9f82b2d4e99c4bbdfccf684e52cc06ea06a0b567bfd0d08f9c5a3f417055996 \
  https://repo.maven.apache.org/maven2/org/bouncycastle/bcpkix-jdk18on/1.85/bcpkix-jdk18on-1.85.jar \
  /opt/keycloak/lib/lib/main/org.bouncycastle.bcpkix-jdk18on-1.84.jar
ADD --checksum=sha256:590f55ed5d68529239898a4a5c4f730b6e37f45d1cfa3fbe51f8485abe32c42d \
  https://repo.maven.apache.org/maven2/org/bouncycastle/bcutil-jdk18on/1.85/bcutil-jdk18on-1.85.jar \
  /opt/keycloak/lib/lib/main/org.bouncycastle.bcutil-jdk18on-1.84.jar
RUN cp /opt/keycloak/lib/lib/main/org.bouncycastle.bcprov-jdk18on-1.84.jar \
  /opt/keycloak/bin/client/lib/bcprov-jdk18on-1.84.jar

FROM python@sha256:46837ed3105db0029b6d656816185c6258e3b39690532fb782428e0a5fd76182 AS jackson-patch
COPY --from=keycloak /opt/keycloak/bin/client/keycloak-admin-cli-26.7.3.jar /tmp/keycloak-admin-cli-26.7.3.jar
ADD --checksum=sha256:1290c2795e93e8a6861a6c4d9ff0d844d32f5ea178362cb2721edf5561e828b1 \
  https://repo.maven.apache.org/maven2/com/fasterxml/jackson/core/jackson-databind/2.21.7/jackson-databind-2.21.7.jar \
  /tmp/jackson-databind-2.21.7.jar
ADD --checksum=sha256:8c5623b98f32d5f7e1287ff61ed50e08ab7b11381e991fff89327faabba42261 \
  https://repo.maven.apache.org/maven2/com/fasterxml/jackson/core/jackson-core/2.21.7/jackson-core-2.21.7.jar \
  /tmp/jackson-core-2.21.7.jar
COPY scripts/release/patch-keycloak-jackson.py /tmp/patch-keycloak-jackson.py
# Pin the upstream CLI before replacing its complete embedded Jackson dependency.
RUN echo '1f1935812026b0a5acbdb3717c9685b257f811b133a9bec455f0b2f0110321dc  /tmp/keycloak-admin-cli-26.7.3.jar' | sha256sum --check \
    && python /tmp/patch-keycloak-jackson.py /tmp/keycloak-admin-cli-26.7.3.jar /tmp/jackson-databind-2.21.7.jar /tmp/jackson-core-2.21.7.jar

FROM ${WOLFI_BASE} AS mail-fence
RUN apk add --no-cache 'openjdk-21=21.0.12.1-r2'
ENV PATH=/usr/lib/jvm/java-21-openjdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
COPY infra/docker/full/keycloak/mail-fence/ /build/src/
COPY --from=keycloak /opt/keycloak/lib/lib/main/ /keycloak-jars/
RUN mkdir -p /build/classes /build/test \
    && javac -cp '/keycloak-jars/*' -d /build/classes /build/src/*Factory.java \
    && javac -cp '/keycloak-jars/*:/build/classes' -d /build/test /build/src/MailFenceTest.java \
    && java -cp '/keycloak-jars/*:/build/classes:/build/test' org.wasalx.keycloak.MailFenceTest \
    && jar --create --file /build/wasalx-mail-fence.jar -C /build/classes . -C /build/src META-INF

FROM ${WOLFI_BASE}
RUN apk add --no-cache 'libcrypto3=3.6.5-r1' 'libssl3=3.6.5-r1' \
      'bash=5.3-r13' \
      'openjdk-21-jre=21.0.12.1-r2' \
      'zlib=1.3.1-r51'
COPY --from=keycloak --chown=1000:1000 /opt/keycloak /opt/keycloak
COPY --from=mail-fence --chown=1000:1000 /build/wasalx-mail-fence.jar /opt/keycloak/providers/wasalx-mail-fence.jar
COPY --from=jackson-patch --chown=1000:1000 /tmp/keycloak-admin-cli-26.7.3.jar /opt/keycloak/bin/client/keycloak-admin-cli-26.7.3.jar
COPY --from=jackson-patch --chown=1000:1000 /tmp/jackson-databind-2.21.7.jar /opt/keycloak/lib/lib/main/com.fasterxml.jackson.core.jackson-databind-2.21.7.jar
COPY --from=jackson-patch --chown=1000:1000 /tmp/jackson-core-2.21.7.jar /opt/keycloak/lib/lib/main/com.fasterxml.jackson.core.jackson-core-2.21.7.jar
# Quarkus serializes library paths. Equal-length replacements preserve its format.
# Keep actual version filenames so package scanners identify the fixed bytes.
RUN set -eu; for artifact in bcprov bcpkix bcutil; do \
      mv /opt/keycloak/lib/lib/main/org.bouncycastle.${artifact}-jdk18on-1.84.jar \
         /opt/keycloak/lib/lib/main/org.bouncycastle.${artifact}-jdk18on-1.85.jar || exit 1; \
    done \
    && mv /opt/keycloak/bin/client/lib/bcprov-jdk18on-1.84.jar /opt/keycloak/bin/client/lib/bcprov-jdk18on-1.85.jar \
    && rm /opt/keycloak/lib/lib/main/com.fasterxml.jackson.core.jackson-databind-2.21.5.jar \
          /opt/keycloak/lib/lib/main/com.fasterxml.jackson.core.jackson-core-2.21.5.jar \
    && for metadata in \
      /opt/keycloak/lib/quarkus/quarkus-application.dat \
      /opt/keycloak/lib/lib/deployment/deployment-class-path.dat \
      /opt/keycloak/lib/lib/deployment/appmodel.dat; do \
        grep -aq 'jdk18on-1\.84' "$metadata"; \
        sed -i 's/jdk18on-1\.84/jdk18on-1.85/g' "$metadata"; \
        if grep -aq 'jdk18on-1\.84' "$metadata"; then exit 1; fi; \
        grep -aq 'jackson-databind-2\.21\.5' "$metadata"; \
        sed -i 's/jackson-databind-2\.21\.5/jackson-databind-2.21.7/g' "$metadata"; \
        if grep -aq 'jackson-databind-2\.21\.5' "$metadata"; then exit 1; fi; \
        grep -aq 'jackson-core-2\.21\.5' "$metadata"; \
        sed -i 's/jackson-core-2\.21\.5/jackson-core-2.21.7/g' "$metadata"; \
        if grep -aq 'jackson-core-2\.21\.5' "$metadata"; then exit 1; fi; \
      done
ENV KC_RUN_IN_CONTAINER=true
ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk
ENV PATH=/usr/lib/jvm/java-21-openjdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ARG WASALX_CANDIDATE_SHA=unfrozen
ARG WASALX_CANDIDATE_TREE=unfrozen
LABEL org.opencontainers.image.revision="${WASALX_CANDIDATE_SHA}" \
      io.wasalx.source.tree="${WASALX_CANDIDATE_TREE}"
USER 1000:1000
# Check the Compose readiness shell as the runtime user during the image build.
RUN /bin/bash -ec '/opt/keycloak/bin/kc.sh --version && /opt/keycloak/bin/kcadm.sh --help >/dev/null'
# Start the final image's server with both SPIs without persisting the H2 or augmented build files.
RUN /bin/bash -ec '\
    work=$(mktemp -d); pid=; \
    cleanup() { if [[ -n "$pid" ]]; then kill "$pid" 2>/dev/null || true; wait "$pid" || true; fi; rm -rf "$work"; }; \
    trap cleanup EXIT; \
    cp -a /opt/keycloak/. "$work"; \
    WASALX_TEST_EMAIL_RECIPIENT_ALLOWLIST="[]" "$work/bin/kc.sh" start-dev --db=dev-mem --http-host=127.0.0.1 --health-enabled=true \
      --spi-email-sender--provider=wasalx-fenced --spi-email-template--provider=wasalx-fenced >"$work/start.log" 2>&1 & pid=$!; \
    ready() { printf "GET /health/ready HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n" >&3; \
      IFS= read -r -t 2 status <&3 && [[ "$status" == *" 200 "* ]]; }; \
    for attempt in {1..90}; do \
      kill -0 "$pid" 2>/dev/null || break; \
      if { ready 3<>/dev/tcp/127.0.0.1/9000; } 2>/dev/null; then exit 0; fi; \
      sleep 1; \
    done; \
    cat "$work/start.log"; exit 1'
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
