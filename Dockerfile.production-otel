# syntax=docker/dockerfile:1.7
FROM docker.io/library/golang:1.27.4-alpine@sha256:70bd7ddea8b6cbe5d6943cde279d6b67feb10cc924fb9100d1d8757c1575b280 AS build
ENV GOPROXY=https://proxy.golang.org,direct
ENV GODEBUG=http2client=0
WORKDIR /src
ADD https://github.com/open-telemetry/opentelemetry-collector.git#4b5ae43f8998fedf783b52917ff0ffb7cad1ed48:cmd/builder /src/collector-builder
RUN cat > builder.yaml <<'EOF'
dist:
  name: otelcol-wasalx
  description: WasalX production OpenTelemetry collector
  version: 0.166.0
  output_path: /src/otelcol-wasalx
  otelcol_version: 0.166.0
extensions:
  - gomod: github.com/open-telemetry/opentelemetry-collector-contrib/extension/healthcheckextension v0.166.0
receivers:
  - gomod: go.opentelemetry.io/collector/receiver/otlpreceiver v0.166.0
processors:
  - gomod: go.opentelemetry.io/collector/processor/batchprocessor v0.166.0
  - gomod: go.opentelemetry.io/collector/processor/memorylimiterprocessor v0.166.0
  - gomod: github.com/open-telemetry/opentelemetry-collector-contrib/processor/attributesprocessor v0.166.0
exporters:
  - gomod: go.opentelemetry.io/collector/exporter/debugexporter v0.166.0
  - gomod: github.com/open-telemetry/opentelemetry-collector-contrib/exporter/prometheusexporter v0.166.0
EOF
RUN go -C /src/collector-builder build -o /go/bin/builder . \
    && /go/bin/builder --config builder.yaml \
    && cd /src/otelcol-wasalx \
    && go mod tidy \
    && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/otelcol-wasalx .

FROM gcr.io/distroless/static-debian13:nonroot@sha256:8ce6dd87e9823c5b48dcfb2c8604714ccb351ce59607327bcc4957448da279b5
COPY --from=build /out/otelcol-wasalx /otelcol-wasalx
ARG WASALX_CANDIDATE_SHA=unfrozen
ARG WASALX_CANDIDATE_TREE=unfrozen
LABEL org.opencontainers.image.title="WasalX production OpenTelemetry collector" \
      org.opencontainers.image.version="0.166.0" \
      org.opencontainers.image.revision="${WASALX_CANDIDATE_SHA}" \
      io.wasalx.source.tree="${WASALX_CANDIDATE_TREE}"
USER 65532:65532
ENTRYPOINT ["/otelcol-wasalx"]
