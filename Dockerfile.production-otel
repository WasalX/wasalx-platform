# syntax=docker/dockerfile:1.7
FROM docker.io/library/golang:1.26.8-alpine@sha256:ce864e7223ac17b1775e6fd0b4c0db580c2eb50e7953a427916379e4b92a1628 AS build
ENV GOPROXY=https://proxy.golang.org,direct
WORKDIR /src
RUN cat > builder.yaml <<'EOF'
dist:
  name: otelcol-wasalx
  description: WasalX production OpenTelemetry collector
  version: 0.160.0
  output_path: /src/otelcol-wasalx
  otelcol_version: 0.160.0
extensions:
  - gomod: github.com/open-telemetry/opentelemetry-collector-contrib/extension/healthcheckextension v0.160.0
receivers:
  - gomod: go.opentelemetry.io/collector/receiver/otlpreceiver v0.160.0
processors:
  - gomod: go.opentelemetry.io/collector/processor/batchprocessor v0.160.0
  - gomod: go.opentelemetry.io/collector/processor/memorylimiterprocessor v0.160.0
  - gomod: github.com/open-telemetry/opentelemetry-collector-contrib/processor/attributesprocessor v0.160.0
exporters:
  - gomod: go.opentelemetry.io/collector/exporter/debugexporter v0.160.0
  - gomod: github.com/open-telemetry/opentelemetry-collector-contrib/exporter/prometheusexporter v0.160.0
EOF
RUN go install go.opentelemetry.io/collector/cmd/builder@v0.160.0 \
    && /go/bin/builder --config builder.yaml \
    && cd /src/otelcol-wasalx \
    && go get golang.org/x/crypto@v0.56.0 \
    && go mod tidy \
    && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/otelcol-wasalx .

FROM gcr.io/distroless/static-debian13:nonroot@sha256:1c2c046bc09ed40fad370b599a0b1ae7987f55b01e247cf27a7c27cd97e5bbc7
COPY --from=build /out/otelcol-wasalx /otelcol-wasalx
ARG WASALX_CANDIDATE_SHA=unfrozen
ARG WASALX_CANDIDATE_TREE=unfrozen
LABEL org.opencontainers.image.title="WasalX production OpenTelemetry collector" \
      org.opencontainers.image.version="0.160.0" \
      org.opencontainers.image.revision="${WASALX_CANDIDATE_SHA}" \
      io.wasalx.source.tree="${WASALX_CANDIDATE_TREE}"
USER 65532:65532
ENTRYPOINT ["/otelcol-wasalx"]
