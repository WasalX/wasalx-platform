{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "re2-wasm": ["./node_modules/re2-wasm"]
    },
    "rootDir": "../../lib",
    "outDir": "dist",
    "declaration": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": false,
    "incremental": false,
    "types": ["node"]
  },
  "include": ["../../lib/domain.ts"],
  "exclude": ["node_modules", "dist"]
}
