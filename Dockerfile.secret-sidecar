# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim@sha256:be979e5523c76fa4d5ca4ebd3099078f220aa47ec39c48ad5b5df9314debd6eb AS node-base

FROM node-base AS data
RUN install -d -o 65532 -g 65532 -m 0700 /data

FROM cgr.dev/chainguard/wolfi-base:latest@sha256:4cf5932a0f95a88af352f77e4efa67480cab0e1f7a48f0eddca3cce003a7c0fb
RUN apk add --no-cache 'libcrypto3=3.6.5-r1' 'libssl3=3.6.5-r1' 'libstdc++=16.2.0-r1' 'zlib=1.3.1-r51'
COPY --from=node-base /usr/local/bin/node /usr/bin/node
RUN node -e "const assert = require('node:assert/strict'); assert.equal(process.version, 'v22.23.5'); assert.equal(process.versions.undici, '6.29.1')"
ENTRYPOINT []
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV NODE_ENV=development
ENV PORT=8082
WORKDIR /app
COPY --from=data --chown=65532:65532 --chmod=0700 /data /data
COPY --chown=65532:65532 tools/dev-secret-sidecar.mjs ./server.mjs
ARG WASALX_CANDIDATE_SHA=unfrozen
ARG WASALX_CANDIDATE_TREE=unfrozen
LABEL org.opencontainers.image.revision="${WASALX_CANDIDATE_SHA}" \
      io.wasalx.source.tree="${WASALX_CANDIDATE_TREE}"
USER 65532:65532
EXPOSE 8082
HEALTHCHECK --interval=20s --timeout=10s --start-period=30s --retries=5 CMD ["node","-e","fetch('http://127.0.0.1:8082/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["node","server.mjs"]
