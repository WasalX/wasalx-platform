          "type": "string",
          "example": "123123@lid"
        },
        "jid": {
          "type": "string",
          "example": "123123:123@s.whatsapp.net",
          "description": "Your id with device number"
        },
        "reachoutTimelock": {
          "nullable": true,
          "description": "WhatsApp reachout timelock (account restriction) info. Null if no enforcement has been seen for the account.",
