    "WAMessageAckBody": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Message ID",
          "example": "false_11111111111@c.us_AAAAAAAAAAAAAAAAAAAA"
        },
        "from": {
          "type": "string",
          "example": "11111111111@c.us"
        },
        "to": {
          "type": "string",
          "example": "11111111111@c.us"
        },
        "participant": {
          "type": "string",
          "example": "11111111111@c.us"
        },
        "fromMe": {
          "type": "boolean"
        },
