# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim@sha256:be979e5523c76fa4d5ca4ebd3099078f220aa47ec39c48ad5b5df9314debd6eb AS node-base

FROM node-base AS dependencies
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV XDG_CACHE_HOME=/pnpm/cache
RUN corepack enable && corepack prepare pnpm@11.16.0 --activate
WORKDIR /workspace
COPY infra/docker/pnpm.npmrc ./.npmrc
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
COPY services/control-api/package.json ./services/control-api/package.json
COPY services/connector-worker/package.json ./services/connector-worker/package.json
COPY services/tenant-provisioner/package.json ./services/tenant-provisioner/package.json
COPY services/invitation-mailer/package.json ./services/invitation-mailer/package.json
COPY services/identity-policy-activator/package.json ./services/identity-policy-activator/package.json
COPY packages/observability/package.json ./packages/observability/package.json
COPY packages/core/package.json ./packages/core/package.json
RUN --mount=type=cache,id=wasalx-pnpm-v11,target=/pnpm/store,sharing=locked \
    --mount=type=cache,id=pnpm-metadata,target=/pnpm/cache,sharing=locked \
    pnpm install --frozen-lockfile --prefer-offline

FROM dependencies AS build
COPY services/identity-policy-activator ./services/identity-policy-activator
COPY packages/observability ./packages/observability
COPY tsconfig.json ./tsconfig.json
RUN pnpm --filter @wasalx/observability build
RUN pnpm --filter @wasalx/identity-policy-activator build
RUN --mount=type=cache,id=wasalx-pnpm-v11,target=/pnpm/store,sharing=locked \
    --mount=type=cache,id=pnpm-metadata,target=/pnpm/cache,sharing=locked \
    pnpm --prefer-offline --filter @wasalx/identity-policy-activator deploy --prod --legacy /identity-policy-activator
RUN cp -R services/identity-policy-activator/dist /identity-policy-activator/dist
RUN observability_package="$(find /identity-policy-activator/node_modules/.pnpm -path '*/node_modules/@wasalx/observability' -type d -print -quit)" \
    && test -n "$observability_package" \
    && test -f "$observability_package/dist/node.js" \
    && test -L /identity-policy-activator/node_modules/@wasalx/observability \
    && unlink /identity-policy-activator/node_modules/@wasalx/observability \
    && observability_relative="../${observability_package#/identity-policy-activator/node_modules/}" \
    && ln -s "$observability_relative" /identity-policy-activator/node_modules/@wasalx/observability \
    && cd /identity-policy-activator \
    && node -e "import('@wasalx/observability/node')"

FROM cgr.dev/chainguard/wolfi-base:latest@sha256:5172a213d2bba8b1c9ca11957db65562b52b0f9844583a0347318ea5fd8e3aa5 AS runtime
RUN apk add --no-cache 'libcrypto3=3.6.5-r1' 'libssl3=3.6.5-r1' 'libstdc++=16.2.0-r1' 'zlib=1.3.1-r51'
COPY --from=node-base /usr/local/bin/node /usr/bin/node
RUN node -e "const assert = require('node:assert/strict'); assert.equal(process.version, 'v22.23.5'); assert.equal(process.versions.undici, '6.29.1')"
ENTRYPOINT []
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV NODE_ENV=production
ENV PORT=8086
WORKDIR /app
COPY --from=build --chown=65532:65532 /identity-policy-activator/ ./
ARG WASALX_CANDIDATE_SHA=unfrozen
ARG WASALX_CANDIDATE_TREE=unfrozen
LABEL org.opencontainers.image.revision="${WASALX_CANDIDATE_SHA}" \
      io.wasalx.source.tree="${WASALX_CANDIDATE_TREE}"
USER 65532:65532
EXPOSE 8086
HEALTHCHECK --interval=20s --timeout=3s --start-period=15s --retries=3 CMD ["node","-e","fetch('http://127.0.0.1:8086/readyz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
ENTRYPOINT ["node","dist/bootstrap.js"]
