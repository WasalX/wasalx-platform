# Secret-manager injected values; never commit real credentials.
WAHA_BASE_URL=http://waha.private.svc.cluster.local:3000
WAHA_ADMIN_BASE_URL=http://waha.private.svc.cluster.local:3000
WAHA_ADMIN_SECRET_REFERENCE=secret://platform/waha-admin
# Public HTTPS origin only; connector workers append opaque webhook routes.
PUBLIC_WEBHOOK_BASE_URL=https://hooks.example.com
WAHA_WEBHOOK_SECRET=fake-test-key-not-a-secret-00000000000000000000000000000000000000
ZAMMAD_BASE_URL=https://tenant.example.internal
# Per Zammad instance, store three separate properties under the instance's
# service secret reference: token (least-privilege Zammad REST API token),
# jwt_secret (dedicated package-to-control HS256 key), and instance_id.
META_APP_SECRET=fake-test-key-not-a-secret-00000000000000000000000000000000000000
META_VERIFY_TOKEN=fake-test-key-not-a-secret-00000000000000000000000000000000000000
META_GRAPH_VERSION=v24.0
# Non-production routing fixtures using an alternate HTTPS Graph origin require an exact evidence binding.
META_ROUTING_SIMULATION_BINDING_SHA256=
# Customer-paid Embedded Signup stays disabled until reviewed Meta app configuration is ready.
META_SIGNUP_ENABLED=false
META_SIGNUP_CUSTOMER_CONFIG_ID=
# Business app onboarding stays off until its separate Meta configuration is approved.
META_COEXISTENCE_ENABLED=false
META_SIGNUP_BUSINESS_APP_CONFIG_ID=
# Nonsecret server app identity; required when admitting new Meta credentials.
META_APP_ID=
# Default off. Set to exactly true in the control API and connector worker only
# after external client-routing connectors are approved.
CLIENT_ROUTING_EXTERNAL_CONNECTORS_ENABLED=false
# Notion's public OAuth callback is always `${PUBLIC_PORTAL_BASE_URL}/api/client-routing/oauth/notion/callback`.
# The client secret itself stays in the secret sidecar under the reference below as `hmacKey`.
PUBLIC_PORTAL_BASE_URL=https://app.example.com
NOTION_OAUTH_CLIENT_ID=replace-with-notion-public-integration-client-id
NOTION_OAUTH_CLIENT_SECRET_REFERENCE=secret://platform/notion-oauth-client
WAHA_DELIVERY_MAX_ATTEMPTS=8
META_DELIVERY_MAX_ATTEMPTS=8
ZAMMAD_STATUS_MAX_ATTEMPTS=8
# Bot retry ceilings. Set the same handoff value in the worker and control API.
BOT_ACTION_MAX_ATTEMPTS=8
BOT_HANDOFF_MAX_ATTEMPTS=8
DATABASE_URL=postgresql://fixture:placeholder@db.example.test:5432/example_db
WAHA_REGISTRY_DATABASE_URL=postgresql://fixture:placeholder@db.example.test:5432/example_db
WAHA_OPERATOR_DATABASE_URL=postgresql://fixture:placeholder@db.example.test:5432/example_db
METERING_INGEST_DATABASE_URL=postgresql://fixture:placeholder@db.example.test:5432/example_db
PLATFORM_OPERATIONS_DATABASE_URL=postgresql://fixture:placeholder@db.example.test:5432/example_db
INVITATION_MAILER_DATABASE_URL=postgresql://fixture:placeholder@db.example.test:5432/example_db
# Optional only for an intentionally dedicated single-tenant mailer. Omit for
# the shared discovery-capable mailer deployment.
# INVITATION_MAILER_TENANT_ID=replace-with-tenant-uuid
INVITATION_TOKEN_PRIVATE_KEY_REFERENCES_JSON={"local-v1":"secret://tenant/invitation-token-private-key"}
# HTTPS transactional endpoint, or SMTP submission with the username but no password in the URL.
INVITATION_EMAIL_PROVIDER_URL=smtp://smtp.example.com:587
INVITATION_EMAIL_PROVIDER_SECRET_REFERENCE=secret://tenant/invitation-email-provider
INVITATION_EMAIL_FROM=support@example.com
INVITATION_EMAIL_TEMPLATE_ID=wasalx-invitation-v1
IDENTITY_POLICY_DATABASE_URL=postgresql://fixture:placeholder@db.example.test:5432/example_db
IDENTITY_POLICY_ATTESTATION_ISSUER=https://identity-verifier.example.com
IDENTITY_POLICY_ATTESTATION_AUDIENCE=wasalx-identity-policy-activator
IDENTITY_POLICY_ATTESTATION_JWKS_URI=https://identity-verifier.example.com/.well-known/jwks.json
# Required by the connector worker in production. Every baseUrl must resolve to
# a private WAHA endpoint and every secretReference must resolve at runtime.
WAHA_WORKERS_JSON=[{"workerKey":"gows-prod-a","engine":"GOWS","baseUrl":"https://waha-gows-a.private.svc.cluster.local","secretReference":"secret://platform/waha/gows-prod-a","capacity":100,"rolloutMode":"STABLE","heartbeatTtlSeconds":45}]
REDIS_URL=rediss://redis.private.svc:6379
WORKER_JOB_JWT_SECRET=fake-test-key-not-a-secret-00000000000000000000000000000000000000
METERING_SERVICE_JWT_SECRET=fake-test-key-not-a-secret-00000000000000000000000000000000000000
METERING_CATCHUP_PERIODS_PER_TICK=4
METERING_RECONCILE_INTERVAL_MS=60000
SECRET_SIDECAR_URL=https://secrets-agent.private.svc:8443
SECRET_SIDECAR_TOKEN=fake-test-key-not-a-secret-00000000000000000000000000000000000000
OIDC_ISSUER=https://identity.example.com/realms/wasalx
OIDC_AUDIENCE=wasalx-control-api
OIDC_JWKS_URI=https://identity.example.com/realms/wasalx/protocol/openid-connect/certs
OIDC_CLIENT_ID=wasalx-portal
OIDC_REDIRECT_URI=https://app.example.com/auth/callback
OIDC_INVITATION_REDIRECT_URI=https://app.example.com/invitations/callback
# Required assurance context requested for privileged step-up. Configure the
# same exact value in the IdP authentication flow; it is never inferred.
OIDC_PRIVILEGED_ACR_VALUES=urn:wasalx:loa:2
# Comma/space-separated access-token amr values that authoritatively mean MFA.
OIDC_PRIVILEGED_MFA_AMR_VALUES=mfa
PORTAL_PUBLIC_ORIGIN=https://app.example.com
# RSA SPKI public key (base64 DER or PEM) used only to encrypt single-use
# invitation tokens. The corresponding private key belongs only to the
# invitation-mailer worker secret.
INVITATION_TOKEN_ENCRYPTION_PUBLIC_KEY=replace-with-base64-spki-public-key
INVITATION_TOKEN_KEY_VERSION=local-v1
PLATFORM_OPERATOR_OIDC_ISSUER=https://identity.example.com/realms/wasalx-platform
PLATFORM_OPERATOR_OIDC_AUDIENCE=wasalx-platform-api
PLATFORM_OPERATOR_OIDC_JWKS_URI=https://identity.example.com/realms/wasalx-platform/protocol/openid-connect/certs
PLATFORM_OPERATOR_OIDC_CLIENT_ID=wasalx-platform-portal
PLATFORM_OPERATOR_OIDC_REDIRECT_URI=https://app.example.com/platform/auth/callback
PLATFORM_OPERATOR_OIDC_ACR_VALUES=
PLATFORM_OPERATOR_MAX_AUTH_AGE_SECONDS=900
PLATFORM_PORTAL_SESSION_REDIS_URL=rediss://redis.private.svc:6379
PLATFORM_PORTAL_SESSION_SECRET=fake-test-key-not-a-secret-00000000000000000000000000000000000000
SUPPORT_ACCESS_DATABASE_URL=postgresql://fixture:placeholder@db.example.test:5432/example_db
PROVISIONING_DATABASE_URL=postgresql://fixture:placeholder@db.example.test:5432/example_db
PROVISIONING_DRIVER_URL=http://wasalx-tenant-provisioner:8090
PROVISIONING_DRIVER_JWT_SECRET=fake-test-key-not-a-secret-00000000000000000000000000000000000000
# Control API release catalog. These digest-pinned values are copied into each
# new tenant's immutable signed provisioning request; changing them never
# upgrades an existing tenant.
WASALX_ZAMMAD_PACKAGE_VERSION=0.5.86
WASALX_ZAMMAD_PACKAGE_SHA256=e569457480505547aafb9de429f791184cac0e4b5ad7c282894ac23412eed3c9

WASALX_ZAMMAD_IMAGE_BY_VERSION_JSON={"7.1.3":"registry.example.com/wasalx/zammad@sha256:replace-with-64-lowercase-hex"}
WASALX_ZAMMAD_CONFIGURATOR_IMAGE=registry.example.com/wasalx/workspace-configurator@sha256:replace-with-64-lowercase-hex
WASALX_ZAMMAD_NGINX_IMAGE=nginxinc/nginx-unprivileged@sha256:replace-with-64-lowercase-hex
WASALX_ZAMMAD_REDIS_IMAGE=redis@sha256:replace-with-64-lowercase-hex
WASALX_ZAMMAD_MEMCACHED_IMAGE=memcached@sha256:replace-with-64-lowercase-hex

# Tenant provisioner only; do not inject the Kubernetes token into the portal,
# control API, connector worker, or migration job.
KUBERNETES_API_URL=https://kubernetes.default.svc
KUBERNETES_BEARER_TOKEN_FILE=/var/run/secrets/wasalx-kubernetes/token
PROVISIONING_WORKSPACE_NAMESPACE=wasalx
PROVISIONING_RECONCILER_IDENTITY=wasalx-workspace-controller/v1
PROVISIONING_WORKSPACE_BASE_DOMAIN=support.example.com
PROVISIONING_OIDC_ISSUER=https://identity.example.com/realms/wasalx
WASALX_CONTROL_URL=https://control-api.platform.svc.cluster.local
WASALX_PORTAL_URL=https://app.example.com
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability.svc:4318
# Control API only: dedicated read-only credentials for short-lived privacy
# export downloads. Do not reuse the connector worker's write/delete key.
PRIVACY_EXPORT_S3_ENDPOINT=https://objects.example.internal
PRIVACY_EXPORT_S3_REGION=sa-east-1
PRIVACY_EXPORT_S3_BUCKET=wasalx-media
PRIVACY_EXPORT_S3_ACCESS_KEY_ID=replace-read-only-access-key
PRIVACY_EXPORT_S3_SECRET_ACCESS_KEY=replace-read-only-secret-key

# Local Compose only. Replace every default before any shared environment.
# WASALX_FULL_QUALIFICATION_OWNER_USERNAME=example.owner
# WASALX_FULL_ISOLATION_OWNER_USERNAME=example.isolation
# WASALX_FULL_PLATFORM_OPERATOR_USERNAME=example.platform
WASALX_FULL_QUALIFICATION_OWNER_EMAIL=fixture-0001@example.test
WASALX_FULL_KEYCLOAK_SMTP_HOST=example.test
WASALX_FULL_KEYCLOAK_SMTP_PORT=587
WASALX_FULL_KEYCLOAK_SMTP_FROM=fixture-0002@example.test
WASALX_FULL_KEYCLOAK_SMTP_USER=fixture-0002@example.test
WASALX_FULL_KEYCLOAK_SMTP_PASSWORD=fake-example-password
# DEV uses a JSON array of exact test addresses. [] denies invitation and Keycloak mail.
# Staging and production use WASALX_TEST_EMAIL_RECIPIENT_ALLOWLIST=*.
WASALX_TEST_EMAIL_RECIPIENT_ALLOWLIST=[]
WASALX_KEYCLOAK_PASSWORD_RESET_ENABLED=false
WASALX_ADMIN_PASSWORD=fake-example-password
WASALX_APP_PASSWORD=fake-example-password
WASALX_SECRET_CLEANUP_DB_PASSWORD=fake-example-password
WASALX_CONNECTOR_WORKER_DB_PASSWORD=fake-example-password
WASALX_PROVISIONING_DB_PASSWORD=fake-example-password
WASALX_SUPPORT_DB_PASSWORD=fake-example-password
WASALX_WAHA_REGISTRY_DB_PASSWORD=fake-example-password
WASALX_WAHA_OPERATOR_DB_PASSWORD=fake-example-password
WASALX_WAHA_ROLLOUT_GATE_DB_PASSWORD=fake-example-password
WASALX_INVITATION_MAILER_DB_PASSWORD=fake-example-password
WASALX_IDENTITY_POLICY_DB_PASSWORD=fake-example-password
WASALX_METERING_INGEST_DB_PASSWORD=fake-example-password
WASALX_PLATFORM_OPERATIONS_DB_PASSWORD=fake-example-password
# WASALX_FULL_ZAMMAD_BOOTSTRAP_EMAIL=fixture-0003@example.test
# WASALX_FULL_ZAMMAD_BOOTSTRAP_PREVIOUS_EMAIL=fixture-0004@example.test
# WASALX_FULL_ZAMMAD_AGENT_EMAIL=fixture-0005@example.test
WASALX_FULL_ZAMMAD_API_TOKEN=fake-test-key-not-a-secret-00000000000000000000000000000000000000
WASALX_FULL_ZAMMAD_SERVICE_JWT_SECRET=fake-test-key-not-a-secret-00000000000000000000000000000000000000
WASALX_FULL_ZAMMAD_PRIVACY_TOKEN=fake-test-key-not-a-secret-00000000000000000000000000000000000000
SECRET_SIDECAR_TOKEN=fake-test-key-not-a-secret-00000000000000000000000000000000000000
SECRET_SIDECAR_WRITE_TOKEN=fake-test-key-not-a-secret-00000000000000000000000000000000000000
# Generate with: openssl rand -base64 32
DEV_SECRET_STORE_ENCRYPTION_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
DEV_SECRET_STORE_JSON={}
PORTAL_PORT=3000
CONTROL_API_PORT=3001
# Fixture preview only: tenant_owner, tenant_admin, supervisor, agent, auditor.
# The application rejects this override for every non-fixture backend.
PORTAL_FIXTURE_ROLE=tenant_owner

# Approved native customer IMAP/SMTP server hostnames, comma separated. Empty disables setup.
# Local fixture overrides this with mailbox.synthetic.test; no default external recipient.
WASALX_FULL_MAIL_ALLOWED_HOSTS=
# Optional nonproduction TEST sender PHONE policy; empty keeps BSUID-first behavior.
WASALX_META_TEST_PHONE_SENDERS=

PUBLIC_CONTACT_EMAIL=contact@example.invalid
