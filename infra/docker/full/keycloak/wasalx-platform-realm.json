{
  "realm": "wasalx-platform",
  "displayName": "WasalX Platform Operations",
  "enabled": true,
  "loginTheme": "wasalx",
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "ar"],
  "defaultLocale": "en",
  "sslRequired": "none",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": false,
  "verifyEmail": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(14) and digits(1) and lowerCase(1) and upperCase(1) and specialChars(1) and notUsername(undefined)",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 900,
  "ssoSessionMaxLifespan": 3600,
  "offlineSessionIdleTimeout": 0,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA256",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyInitialCounter": 0,
  "otpPolicyLookAheadWindow": 1,
  "browserFlow": "wasalx-platform-browser",
  "authenticatorConfig": [
    {
      "alias": "wasalx-platform-password-reference",
      "config": {
        "default.reference.value": "pwd",
        "default.reference.maxAge": "900"
      }
    },
    {
      "alias": "wasalx-platform-otp-reference",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "900"
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "wasalx-platform-browser",
      "description": "Dedicated password and OTP authentication for platform operators",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorConfig": "wasalx-platform-password-reference",
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorConfig": "wasalx-platform-otp-reference",
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "wasalx-platform-operator",
        "description": "Allows access to the separately authenticated WasalX platform-operations surface"
      }
    ]
  },
  "clients": [
    {
      "clientId": "wasalx-platform-api",
      "name": "WasalX Platform Operations API",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "wasalx-platform-portal",
      "name": "WasalX Platform Operations Portal",
      "enabled": true,
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://127.0.0.1:3000/platform/auth/callback"
      ],
      "webOrigins": [
        "http://127.0.0.1:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:3000/platform/*"
      },
      "protocolMappers": [
        {
          "name": "wasalx-platform-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "wasalx-platform-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "authentication-method-reference",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ],
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "id": "10000000-0000-4000-8000-000000000002",
      "username": "example.platform",
      "email": "fixture-0007@example.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Platform",
      "lastName": "Operator",
      "realmRoles": [
        "wasalx-platform-operator"
      ],
      "requiredActions": [
        "CONFIGURE_TOTP"
      ]
    }
  ]
}
