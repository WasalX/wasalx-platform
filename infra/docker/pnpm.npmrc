# Docker builds share one content-addressable pnpm store. Keep registry pressure
# bounded so a parallel Compose build cannot multiply transient registry errors.
network-concurrency=4
maxsockets=4
cache-dir=/pnpm/cache
fetch-retries=2
fetch-retry-factor=2
fetch-retry-mintimeout=1000
fetch-retry-maxtimeout=10000
fetch-timeout=60000
